# Copy this file to `.env` in the project root and fill in real values.
# `.env` is git-ignored — never commit secrets. All keys are optional in
# development (dev-only fallbacks exist in tria_engine/core/config.py),
# but non-development environments MUST export them or the app refuses to
# boot.

# --- Application environment ----------------------------------------------
# Old name: DJANGO_ENV. Both still work; APP_ENV is preferred.
# APP_ENV=development        # development | uat | production
DJANGO_ENV=development

# Old name: DJANGO_SECRET_KEY (still accepted). SECRET_KEY is preferred.
# SECRET_KEY=change-me

# Old name: DJANGO_ALLOWED_HOSTS (still accepted). ALLOWED_HOSTS preferred.
# ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database -------------------------------------------------------------
# Single source of truth for the DB URL (unchanged). Development without
# this variable falls back to the SQLite file at <root>/db.sqlite3.
# DATABASE_URL=postgres://user:password@host:5432/ctms
# Individual overrides (same env vars the old settings.py read):
# DB_NAME=ctms
# DB_USER=user
# DB_PASSWORD=password
# DB_HOST=host
# DB_PORT=5432
# DB_CONNECT_TIMEOUT_SECONDS=5
# DB_STATEMENT_TIMEOUT_MS=30000
# DB_TRANSACTION_ISOLATION_LEVEL=READ_COMMITTED
# AWS RDS IAM auth (replicates the old tria_engine/db_backends/iam_postgres):
# IAM_DB_AUTH_ENABLED=false
# AWS_REGION=us-east-1

# --- CORS -----------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CORS_ALLOW_CREDENTIALS=true

# --- Cache (optional; in-process fallback mirrors Django's locmem) --------
# REDIS_URL=redis://localhost:6379/0
# CACHE_DEFAULT_TIMEOUT=300

# --- Security -------------------------------------------------------------
# Old name: CTMS_ENCRYPTION_KEY (unchanged — Fernet key for field-level
# encryption helpers).
# CTMS_ENCRYPTION_KEY=

# Old names: TRIA_PASSWORD_MAX_AGE_DAYS / TRIA_TOKEN_EXPIRY_MINUTES /
# TRIA_EXPOSE_OTP_IN_RESPONSE (all unchanged).
# TRIA_PASSWORD_MAX_AGE_DAYS=90
# TRIA_TOKEN_EXPIRY_MINUTES=10
# TRIA_EXPOSE_OTP_IN_RESPONSE=true

# --- File uploads (unchanged) ---------------------------------------------
# TRIA_DOCUMENT_MAX_SIZE=10485760
# TRIA_DOCUMENT_ALLOWED_EXTENSIONS=pdf,doc,docx,xls,xlsx,txt
# TRIA_PROFILE_PHOTO_MAX_SIZE=5242880
# TRIA_PROFILE_PHOTO_ALLOWED_EXTENSIONS=jpg,jpeg,png

# --- Billing / Razorpay (kept for config parity; dormant apps) ------------
# RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxxxxxxxx
# RAZORPAY_KEY_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# RAZORPAY_WEBHOOK_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# BILLING_DEFAULT_PERIOD_DAYS=30

# --- Logging / serving ----------------------------------------------------
# Old name: DJANGO_LOG_LEVEL (still accepted). LOG_LEVEL preferred.
# LOG_LEVEL=INFO
# GUNICORN_WORKERS=3
# GUNICORN_TIMEOUT=120
# GUNICORN_BIND=0.0.0.0:8000
